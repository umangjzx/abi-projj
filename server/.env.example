# ----------------------------------------------------------------------------
# Thuthi Dairy API -- environment configuration
# Copy to `.env` and fill in real values.  Never commit `.env`.
# ----------------------------------------------------------------------------

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------- database ---
# Native PostgreSQL install (default port 5432)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/thuthi_dairy?schema=public"
# ...or the bundled docker-compose service (published on port 5433)
# DATABASE_URL="postgresql://thuthi:thuthi_secret@localhost:5433/thuthi_dairy?schema=public"

# ------------------------------------------------------------------- auth ----
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=10
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Require a verified email address before login is allowed
REQUIRE_EMAIL_VERIFICATION=true

# ------------------------------------------------------------------ email ----
# Leave SMTP_HOST empty to use the console/file transport (development).
# With docker-compose, MailHog listens on localhost:1025 (UI: localhost:8025).
SMTP_HOST=
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Thuthi Dairy <no-reply@thuthidairy.com>"

# ------------------------------------------------------------- cloudinary ---
# Leave empty to store uploads on the local disk (server/uploads).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=thuthi-dairy

# ------------------------------------------------------------------ misc -----
LOG_LEVEL=info
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=25
DELIVERY_FEE=25
FREE_DELIVERY_THRESHOLD=499
TAX_PERCENT=5
LOW_STOCK_THRESHOLD=15
